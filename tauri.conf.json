{
  "build": {
    "distDir": "../dist",
    "devPath": "http://localhost:5173",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "SubTrax",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": false
      },
      "path": {
        "all": false
      },
      "dialog": {
        "all": false
      },
      "process": {
        "all": false
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.subtrax.app",
      "icon": [
        "src-tauri/icons/32x32.png",
        "src-tauri/icons/128x128.png",
        "src-tauri/icons/128x128@2x.png",
        "src-tauri/icons/SDL_migration.png"
      ]
    },
    "windows": [
      {
        "url": "index.html",
        "title": "SubTrax - Track Subscriptions, Not Worries",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ]
  }
}